---
import { siteConfig } from "../../config";
import "../../styles/global.css";

export function getStaticPaths() {
  return siteConfig.projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;

// Contenido demo — reemplazar por el caso real de cada proyecto.
const contexto = {
  desafio:
    "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.",
  solucion:
    "Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.",
};

// Galería demo: 1 pieza full-width + 4 en columnas.
const galeria = [
  { span: "full", label: "Imagen / video principal" },
  { span: "half", label: "Detalle 01" },
  { span: "half", label: "Detalle 02" },
  { span: "half", label: "Detalle 03" },
  { span: "half", label: "Detalle 04" },
];
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={project.description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{project.name} — {siteConfig.name} {siteConfig.lastName}</title>
  </head>
  <body>
    <main class="min-h-screen">
      <!-- ═══ HEADER ═══ -->
      <header class="px-6 pt-12 pb-16 sm:pt-16 sm:pb-20 border-b border-[var(--infigo)]/20">
        <div class="max-w-4xl mx-auto">
          <a
            href="/#work"
            class="inline-flex items-center gap-1.5 text-[var(--text-secondary)] text-sm hover:text-[var(--magentra)] hover:gap-2.5 transition-all"
          >
            ← Volver a proyectos
          </a>

          <p class="text-[var(--magentra)] text-sm font-mono tracking-wider mt-10 mb-2">
            // {project.category}
          </p>
          <h1 class="text-3xl sm:text-5xl font-bold leading-tight">{project.name}</h1>

          <div class="flex flex-wrap items-center gap-x-8 gap-y-3 mt-8 text-sm">
            <div>
              <span class="text-[var(--text-secondary)] text-xs uppercase tracking-wider block mb-1">Rol</span>
              <span class="font-medium">{project.role}</span>
            </div>
            <div>
              <span class="text-[var(--text-secondary)] text-xs uppercase tracking-wider block mb-1">Año</span>
              <span class="font-medium">{project.year}</span>
            </div>
          </div>

          <div class="flex flex-wrap gap-2 mt-6">
            {project.tags.map((tag: string) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        </div>
      </header>

      <!-- ═══ CONTEXTO ═══ -->
      <section class="px-6 py-16 sm:py-20">
        <div class="max-w-4xl mx-auto">
          <p class="text-[var(--aqva)] text-sm font-mono tracking-wider mb-8">// CONTEXTO</p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-10">
            <div>
              <h2 class="text-xl font-bold mb-3">El desafío</h2>
              <p class="text-[var(--text-secondary)] leading-relaxed">{contexto.desafio}</p>
            </div>
            <div>
              <h2 class="text-xl font-bold mb-3">La solución</h2>
              <p class="text-[var(--text-secondary)] leading-relaxed">{contexto.solucion}</p>
            </div>
          </div>
        </div>
      </section>

      <!-- ═══ GALERÍA ═══ -->
      <section class="px-6 pb-20 sm:pb-28">
        <div class="max-w-5xl mx-auto">
          <p class="text-[var(--solara)] text-sm font-mono tracking-wider mb-8">// GALERÍA</p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {galeria.map((slot) => (
              <div class={slot.span === "full" ? "sm:col-span-2" : ""}>
                <div class="media-placeholder">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" class="w-8 h-8 opacity-50">
                    <rect x="3" y="3" width="18" height="18" rx="2" />
                    <circle cx="8.5" cy="8.5" r="1.5" />
                    <path d="m21 15-5-5L5 21" />
                  </svg>
                  <span class="text-xs font-mono mt-3 opacity-60">{slot.label}</span>
                </div>
              </div>
            ))}
          </div>

          <p class="text-[var(--text-secondary)] text-xs mt-6 font-mono">
            Placeholders — reemplazar por imágenes o videos del proyecto.
          </p>
        </div>
      </section>

      <!-- ═══ CIERRE ═══ -->
      <section class="px-6 pb-20 sm:pb-28 border-t border-[var(--infigo)]/20 pt-14">
        <div class="max-w-4xl mx-auto text-center">
          <h2 class="text-2xl sm:text-3xl font-bold">{siteConfig.cta.title}</h2>
          <p class="text-[var(--text-secondary)] mt-3 max-w-md mx-auto">{siteConfig.cta.description}</p>
          <a
            href="/#contact"
            class="inline-flex mt-8 px-7 py-3 bg-[var(--magentra)] text-white text-sm font-medium rounded-full hover:shadow-lg hover:shadow-[var(--magentra)]/30 hover:-translate-y-0.5 transition-all"
          >
            {siteConfig.cta.buttonText}
          </a>
        </div>
      </section>
    </main>

    <style>
      .media-placeholder {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        aspect-ratio: 16 / 10;
        border-radius: 0.75rem;
        border: 1px dashed color-mix(in srgb, var(--infigo) 45%, transparent);
        background: var(--bg-light);
        color: var(--coco-silver);
        transition: border-color 0.2s ease, background 0.2s ease;
      }
      .media-placeholder:hover {
        border-color: color-mix(in srgb, var(--magentra) 55%, transparent);
        background: color-mix(in srgb, var(--bg-light) 80%, var(--infigo));
      }
    </style>
  </body>
</html>
