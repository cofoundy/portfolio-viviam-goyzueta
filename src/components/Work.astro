---
import { siteConfig } from "../config";

const projects = siteConfig.projects;
// Chips en orden fijo; "Todos" siempre primero.
const categories = ["Todos", "Web & Dev", "UX/UI", "Media"];
---

<section id="work" class="py-20 sm:py-28 px-6 bg-[var(--bg-light)]">
  <div class="max-w-6xl mx-auto">
    <div class="reveal">
      <p class="text-[var(--magentra)] text-sm font-mono tracking-wider mb-2">// PROYECTOS</p>
      <h2 class="text-3xl sm:text-4xl font-bold">Work</h2>
    </div>

    <div class="section-gradient-line mt-6 mb-8"></div>

    <!-- Filter chips -->
    <div class="reveal flex flex-wrap gap-2.5 mb-10" role="tablist" aria-label="Filtrar proyectos por categoría">
      {categories.map((cat) => (
        <button
          type="button"
          role="tab"
          class="filter-chip px-4 py-2 text-sm rounded-full border transition-all duration-200"
          data-filter={cat}
          aria-selected={cat === "Todos" ? "true" : "false"}
        >
          {cat}
        </button>
      ))}
    </div>

    <!-- Projects grid -->
    <div id="work-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {projects.map((project, i) => (
        <div
          class={`project-item reveal stagger-${Math.min(i + 1, 5)}`}
          data-category={project.category}
        >
          <div class="h-full flex flex-col bg-[var(--bg-light)] border border-[var(--infigo)]/20 rounded-xl p-5 card-hover project-card">
            <h3 class="text-lg font-bold">{project.name}</h3>
            <p class="text-[var(--magentra)] text-xs mt-1">{project.role}</p>
            <p class="text-[var(--text-secondary)] text-sm mt-3 leading-relaxed">
              {project.description}
            </p>
            <div class="flex flex-wrap gap-1.5 mt-4">
              {project.tags.map((tag: string) => (
                <span class="tag text-[0.6rem]">{tag}</span>
              ))}
            </div>
            <a
              href={`/proyectos/${project.slug}`}
              class="mt-auto pt-4 inline-flex items-center gap-1 text-[var(--solara)] text-xs font-medium hover:gap-2 transition-all"
            >
              Ver más →
            </a>
          </div>
        </div>
      ))}
    </div>

    <!-- Empty state (por si una categoría queda sin tarjetas) -->
    <p id="work-empty" class="hidden text-[var(--text-secondary)] text-sm py-10 text-center">
      No hay proyectos en esta categoría todavía.
    </p>
  </div>
</section>

<style>
  .filter-chip {
    border-color: color-mix(in srgb, var(--coco-silver) 28%, transparent);
    color: var(--text-secondary);
    background: transparent;
    cursor: pointer;
  }
  .filter-chip:hover {
    border-color: color-mix(in srgb, var(--magentra) 50%, transparent);
    color: var(--text-primary);
  }
  .filter-chip[aria-selected="true"] {
    background: var(--magentra);
    border-color: var(--magentra);
    color: #fff;
    font-weight: 600;
  }
  .project-item {
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
  .project-item.is-hidden {
    display: none;
  }
  .project-item.is-fading {
    opacity: 0;
    transform: translateY(8px);
  }
</style>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>(".filter-chip");
  const items = document.querySelectorAll<HTMLElement>(".project-item");
  const empty = document.getElementById("work-empty");

  chips.forEach((chip) => {
    chip.addEventListener("click", () => {
      const filter = chip.dataset.filter;

      chips.forEach((c) => c.setAttribute("aria-selected", String(c === chip)));

      let visible = 0;
      items.forEach((item) => {
        const match = filter === "Todos" || item.dataset.category === filter;
        if (match) visible++;

        // fade out → reflow → fade in, para que el grid no salte
        item.classList.add("is-fading");
        setTimeout(() => {
          item.classList.toggle("is-hidden", !match);
          requestAnimationFrame(() => item.classList.remove("is-fading"));
        }, 180);
      });

      if (empty) {
        setTimeout(() => empty.classList.toggle("hidden", visible > 0), 180);
      }
    });
  });
</script>
