---
import { siteConfig } from "../config";
import SocialRow from "./SocialRow.astro";
---

<section id="labs" class="py-20 sm:py-28 px-6">
  <div class="max-w-5xl mx-auto">
    <div class="reveal">
      <p class="text-sm font-mono tracking-wider mb-2" style="color: var(--umbral);">// LABORATORIOS</p>
      <h2 class="text-3xl sm:text-4xl font-bold">Startups &amp; R&amp;D Labs</h2>
      <p class="text-[var(--text-secondary)] text-sm mt-2 max-w-lg">
        Proyectos propios donde convergen diseño, ciencia y tecnología.
      </p>
    </div>

    <div class="section-gradient-line mt-6 mb-12"></div>

    <div class="space-y-6">
      {siteConfig.labs.map((lab, i) => (
        <div class={`reveal stagger-${Math.min(i + 1, 5)}`}>
          <div class="gradient-border card-hover">
            <div class="gradient-border-inner p-6 sm:p-10">
              <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">
                <div class="flex-1">
                  <div class="flex items-center gap-3 mb-3">
                    <div class="w-2 h-2 rounded-full bg-[var(--aqva)] animate-pulse"></div>
                    <span class="text-xs font-mono text-[var(--aqva)] tracking-wider uppercase">
                      {lab.label}
                    </span>
                  </div>

                  <h3 class="text-2xl sm:text-3xl font-bold mt-3">{lab.name}</h3>
                  <p class="text-[var(--magentra)] text-sm mt-1 font-medium">{lab.role}</p>
                  <p class="text-[var(--text-secondary)] text-xs mt-0.5 font-mono">{lab.tagline}</p>

                  <p class="text-[var(--text-secondary)] mt-4 leading-relaxed max-w-xl">
                    {lab.description}
                  </p>

                  <div class="flex flex-wrap gap-2 mt-5">
                    {lab.tags.map((tag: string) => (
                      <span class="tag">{tag}</span>
                    ))}
                  </div>

                  <SocialRow social={lab.social} name={lab.name} />
                </div>

                <a
                  href={lab.link ?? "#contact"}
                  target={lab.link ? "_blank" : undefined}
                  rel={lab.link ? "noopener noreferrer" : undefined}
                  class="mt-4 sm:mt-0 inline-flex items-center gap-1 text-[var(--solara)] text-sm font-medium hover:gap-2 transition-all shrink-0"
                >
                  Ver proyecto →
                </a>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
